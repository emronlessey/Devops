@startuml

title HR System - Use Case Diagram

left to right direction

skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 60

' Actors
actor "HR Advisor" as HR
actor "Department Manager" as DM

' External Database
database "Employee Database" as DB

' HR System Boundary
rectangle "HR System" {

    ' Salary Reporting Use Cases
    usecase "Get salaries\nof all employees" as UC1
    usecase "Get salaries\nby department" as UC2
    usecase "Get salaries\nfor own department" as UC3
    usecase "Get salaries\nby role" as UC4

    ' Employee Management Use Cases
    usecase "Add employee" as UC5
    usecase "View employee" as UC6
    usecase "Update employee" as UC7
    usecase "Delete employee" as UC8

    ' Shared Reporting Function
    usecase "Print salaries" as PRINT
}

' HR Advisor Interactions
HR --> UC1
HR --> UC2
HR --> UC4
HR --> UC5
HR --> UC6
HR --> UC7
HR --> UC8

' Department Manager Interaction
DM --> UC3

' Salary Reporting Relationships
UC1 ..> PRINT : <<include>>
UC2 ..> PRINT : <<include>>
UC3 ..> PRINT : <<include>>
UC4 ..> PRINT : <<include>>

' Database Interactions
UC1 --> DB
UC2 --> DB
UC3 --> DB
UC4 --> DB
UC5 --> DB
UC6 --> DB
UC7 --> DB
UC8 --> DB

@enduml