@startuml

left to right direction

actor "HR Advisor" as HR
actor "Department Manager" as DM

rectangle "HR System" {

    usecase "Get salaries\nof all employees" as UC1
    usecase "Get salaries\nby department" as UC2
    usecase "Get salaries\nfor own department" as UC3
    usecase "Get salaries\nby role" as UC4

    usecase "Add employee" as UC5
    usecase "View employee" as UC6
    usecase "Update employee" as UC7
    usecase "Delete employee" as UC8

    usecase "Print salaries" as PRINT
}

database "Employee Database" as DB

HR --> UC1
HR --> UC2
HR --> UC4
HR --> UC5
HR --> UC6
HR --> UC7
HR --> UC8

DM --> UC3

UC1 ..> PRINT : <<include>>
UC2 ..> PRINT : <<include>>
UC3 ..> PRINT : <<include>>
UC4 ..> PRINT : <<include>>

UC1 --> DB
UC2 --> DB
UC3 --> DB
UC4 --> DB
UC5 --> DB
UC6 --> DB
UC7 --> DB
UC8 --> DB

@enduml